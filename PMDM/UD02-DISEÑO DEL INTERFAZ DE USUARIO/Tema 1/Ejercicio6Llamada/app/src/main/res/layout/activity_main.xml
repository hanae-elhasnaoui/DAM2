<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tv_mesage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textSize="24sp"
        android:layout_margin="20sp"
        android:text="@string/pulsa"
        tools:ignore="VisualLintSystemUi" />

    <ImageButton
        android:id="@+id/btn_llamar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="fitCenter"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/calltel"
        tools:ignore="ImageContrastCheck" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:contentDescription="@string/llamar_por_tel_fono"
        app:srcCompat="@drawable/walterwhite"
        tools:ignore="InefficientWeight" />

</LinearLayout>