<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cual_es_el_mas_mejor_videojuego"
        android:textSize="20sp"
        android:layout_gravity="center"
        android:textColor="@color/material_on_primary_emphasis_high_type"
        android:layout_margin="24sp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="50dp"
        tools:layout_editor_absoluteY="99dp" />

    <TextView
        android:id="@+id/tvChoix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/a_ver_cual_escoges"
        android:layout_gravity="center"
        android:layout_marginBottom="10sp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="135dp"
        tools:layout_editor_absoluteY="216dp" />

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="409dp"
        android:layout_height="257dp"
        android:layout_marginStart="10sp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="268dp">

        <RadioButton
            android:id="@+id/rdminecraft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/minecraft" />

        <RadioButton
            android:id="@+id/rdgrand_theft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grand_theft_auto_v" />

        <RadioButton
            android:id="@+id/rdTetris"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tetris" />

        <RadioButton
            android:id="@+id/rdRed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/red_dead_redemption_2" />
    </RadioGroup>

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="229dp"
        android:layout_height="75dp"
        android:text="@string/te_gusta_la_encuesta"
        android:layout_marginStart="10sp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="91dp"
        tools:layout_editor_absoluteY="560dp" />

</LinearLayout>